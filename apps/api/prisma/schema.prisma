generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AccessTier {
  FULL_DEMO
  LIMITED
}

enum CredentialStatus {
  VALID
  INVALID
}

enum PreferenceSource {
  SERVER
  USER
}

model User {
  id                  String               @id @default(cuid())
  username            String
  usernameNormalized  String               @unique
  passwordHash        String
  role                Role                 @default(USER)
  status              UserStatus           @default(ACTIVE)
  accessTier          AccessTier           @default(LIMITED)
  expiresAt           DateTime?
  mustChangePassword  Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  credentials         ProviderCredential[]
  modelPreference     ModelPreference?
  scans               Scan[]

  @@index([status, expiresAt])
  @@index([role, accessTier])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProviderCredential {
  id              String               @id @default(cuid())
  userId          String
  provider        String               @default("gemini")
  label           String
  encryptedValue  String
  iv              String
  authTag         String
  lastFour        String
  status          CredentialStatus     @default(VALID)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences     ModelPreference[]

  @@index([userId])
}

model ModelPreference {
  id            String              @id @default(cuid())
  userId        String              @unique
  source        PreferenceSource
  profileId     String?
  credentialId  String?
  model         String
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential    ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([credentialId])
}

model Scan {
  id           String   @id @default(cuid())
  userId       String
  title        String
  language     String
  codeHash     String
  codePreview  String
  provider     String
  profileId    String?
  model        String
  summary      String
  findings     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
